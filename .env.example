# LLM providers
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# Embeddings providers
VOYAGE_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=

# Default provider/model fallbacks
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.1-70b-versatile
DEFAULT_EMBEDDINGS_PROVIDER=voyage
DEFAULT_EMBEDDINGS_MODEL=voyage-3

# Feature flags
ENABLE_HITL_AUTOMATION=false

# JEV thresholds (optional overrides)
JEV_ACCEPT_THRESHOLD=0.8
JEV_FLAG_THRESHOLD=0.5

# TypeSafe AI (JEV model) - https://docs.typesafe.ai/api
# Leave TYPESAFE_API_KEY empty to fall back to local heuristic checks instead of the real API.
TYPESAFE_API_KEY=
TYPESAFE_API_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# API
API_PORT=4000
API_HOST=0.0.0.0
WEB_PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_PATH=./data/qa-agent.sqlite
CHECKPOINT_DATABASE_PATH=./data/langgraph-checkpoints.sqlite

# Playwright execution (optional: base URL for generated tests' relative navigation)
TEST_BASE_URL=

